<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>
  <PropertyGroup>
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
    <StaticWebAssetsFingerprintContent>false</StaticWebAssetsFingerprintContent>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Bindings.Blazor-ApexCharts" Version="0.26.1" />
    <PackageReference Include="Codeer.LowCode.Blazor.Extras" Version="0.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.WebUtilities" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Sotsera.Blazor.Toaster" Version="3.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
    <PackageReference Include="MessagePack" Version="3.1.8" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.33" />
  </ItemGroup>
  <!-- サンプル固有: 各種 UI ライブラリのバインディングとハンディターミナル (KHandy) 連携 -->
  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Bindings.Fluent.Blazor" Version="0.11.0" />
    <PackageReference Include="Codeer.LowCode.Bindings.MudBlazor" Version="0.8.0" />
    <PackageReference Include="Codeer.LowCode.Bindings.Radzen.Blazor" Version="0.9.0" />
    <!-- Radzen.Blazor が推移的に参照する System.Linq.Dynamic.Core の脆弱性(GHSA-4cv2-4hjh-77rx)回避のため明示的に最新へ上書き -->
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.7.4" />
    <PackageReference Include="IgniteUI.Blazor.Trial" Version="26.1.98" />
    <PackageReference Include="Blazor.KHandyInterop" Version="0.0.1" />
  </ItemGroup>
</Project>
