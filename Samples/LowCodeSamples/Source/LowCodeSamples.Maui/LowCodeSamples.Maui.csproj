<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <!-- Mobile client only. Add net10.0-windows10.0.19041.0 / net10.0-maccatalyst here if you also want a desktop build. -->
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <!-- No RootNamespace: it must follow the project name so the Razor components (default namespace) and the
         C# files (namespace substituted by the VS template) end up in the same namespace. -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <!-- Display name -->
    <ApplicationTitle>LowCodeSamples</ApplicationTitle>
    <!-- App Identifier (change before publishing to the stores) -->
    <ApplicationId>com.companyname.lowcodesamples</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <!-- Codeer.LowCode.Blazor resolves field/design types by reflection (TypeFinder, FieldDesignManager), so the
       app and library assemblies must not be trimmed. "partial" trims only the framework, the same setting the
       Blazor WebAssembly client publishes with. AOT is a separate matter from trimming and does not affect
       reflection: iOS always AOT-compiles, and on Android the MAUI default (profiled AOT of the startup path,
       JIT for the rest) is kept because it is what makes startup fast on low-end devices. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TrimMode>partial</TrimMode>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Server connection settings, read at startup by MauiProgram -->
    <MauiAsset Include="appsettings.json" />
    <MauiAsset Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.100" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Codeer.LowCode.Blazor" Version="1.3.30" />
    <ProjectReference Include="..\LowCodeSamples.Client.Shared\LowCodeSamples.Client.Shared.csproj" />
  </ItemGroup>
</Project>
