    },
    {
      "Text": "通知メール",
      "Icon": "",
      "IsHtml": false,
      "Style": "H3",
      "RelativeField": "",
      "OnClick": "",
      "Name": "MailTitle",
      "IgnoreModification": false,
      "OnValidateInput": "",
      "IsFocusSkip": false,
      "NextFocusField": "",
      "OnFocusMoving": "",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "承認の順番が回ってきたメンバーには、メンバーモジュールに置いた MailField のテンプレートで通知メールが送られます。送信内容は「メール > 送信履歴」に 1 送信 1 レコード (宛先ごとの明細付き) で記録されます。",
      "Icon": "",
      "IsHtml": false,
      "Style": "Default",
      "RelativeField": "",
      "OnClick": "",
      "Name": "Mail1",
      "IgnoreModification": false,
      "OnValidateInput": "",
      "IsFocusSkip": false,
      "NextFocusField": "",
      "OnFocusMoving": "",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
