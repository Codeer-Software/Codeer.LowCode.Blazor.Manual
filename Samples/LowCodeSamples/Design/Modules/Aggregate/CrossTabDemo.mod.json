          }
        ],
        "Columns": [
          {
            "Variable": "DealType.Value",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.ValueGroup"
          }
        ],
        "Measures": [
          {
            "Name": "件数"
          },
          {
            "Function": "Sum",
            "Variable": "Amount.Value",
            "Name": "売上金額",
            "Format": "N0"
          },
          {
            "Function": "Avg",
