  "Fields": [
    {
      "Text": "クロス集計",
      "Style": "H2",
      "Name": "Heading",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "売上 (2024 年度・2025 年度の約 1,800 件) を DB で集計して表にしています。各表の右上の「集計のカスタマイズ」で、行・列・値・まとめる単位・値の表示形式を自由に組み替えられます (組み替えた内容はこのブラウザに保存され、「設計に戻す」で元に戻せます)。",
      "Name": "Desc",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "Text": "担当者 × 年度四半期 の売上金額 (売上の多い順。セルをクリックすると下に明細を表示)",
      "Style": "H5",
      "Name": "SummaryTitle",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "ResultsViewFieldName": "Summary",
      "Name": "SaleSearch",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.SearchFieldDesign"
    },
    {
      "SearchCondition": {
        "ModuleName": "CrossTabDemoSale"
      },
      "Setting": {
        "Rows": [
          {
            "Variable": "Rep.Value",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.ValueGroup"
          }
        ],
        "Columns": [
          {
            "Bucket": "Quarter",
            "FiscalYearStartMonth": 4,
            "Variable": "SoldOn.Value",
            "TypeFullName": "Codeer.LowCode.Blazor.Repository.Match.DateGroup"
          }
        ],
        "Measures": [
          {
            "Function": "Sum",
            "Variable": "Amount.Value",
            "Name": "売上金額",
            "Format": "N0"
          }
        ],
        "SortConditions": [
          {
            "Target": "Measure",
            "IsDescending": true
          }
        ]
      },
      "CanCustomize": true,
      "OnCellClick": "Summary_OnCellClick",
      "Name": "Summary",
      "TypeFullName": "Codeer.LowCode.Blazor.Extras.Designs.CrossTabFieldDesign"
    },
    {
      "Text": "明細",
      "Style": "H5",
      "Name": "DetailsTitle",
      "TypeFullName": "Codeer.LowCode.Blazor.Repository.Design.LabelFieldDesign"
    },
    {
      "SearchCondition": {
        "LimitCount": 15,
