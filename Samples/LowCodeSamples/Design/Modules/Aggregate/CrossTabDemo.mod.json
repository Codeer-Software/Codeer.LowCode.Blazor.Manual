            "Name": "平均単価",
            "Format": "N0"
          }
        ]
      },
      "CanCustomize": true,
      "Name": "ByMonth",
      "TypeFullName": "Codeer.LowCode.Blazor.Extras.Designs.CrossTabFieldDesign"
