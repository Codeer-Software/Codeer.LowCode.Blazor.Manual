{
  "Mail": {
    "DefaultInfraName": "Gmail",
    "DefaultBulkInfraName": "Gmail",
    "HistoryModuleName": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataSources": [
    {
      "Name": "SampleSQLite",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "PatternsSQLite",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "Inventory",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "Sfa",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "ProjectManagement",
      "DataSourceType": "SQLite"
    },
    {
      "Name": "Main",
      "DataSourceType": "PostgreSQL"
    },
    {
      "Name": "AIChat",
      "DataSourceType": "PostgreSQL"
    }
  ],
  "AIChat": {
    "RawDataAccessDataSources": [ "AIChat" ]
  },
  "FileStorages": [
    {
      "Name": "Azure",
      "FileStorageType": "AzureBlobStorage",
      "ContainerName": "formsfiles"
    }
  ],
  "AllowPasswordLogin": true,
  "MobileLoginCallbackUrl": "lowcodeapp://auth",
  "TotpLogin": {
    "Issuer": "LowCodeNativeSamples"
  },
  "TemporaryFileTableInfo": [
    {
      "DataSourceName": "SampleSQLite",
      "Table": "temporary_files",
      "GuidColumn": "guid",
      "CreatedDateTimeColumn": "created_date_time"
